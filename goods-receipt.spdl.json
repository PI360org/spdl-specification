        "type": "Expert",
        "owner": "Thomas Weber (Quality Engineer)",
        "location": "Dock Area / Office",
        "qualityScore": 8,
        "lastUpdated": "Ongoing",
        "trustLevel": "High"
      }
    ]
  },
